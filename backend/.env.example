PORT=5001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sumora_dev?schema=public"

# Cache & Queues (Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Token Encryption at Rest (32-byte hex string for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth & YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/youtube/callback

# WebSub Webhook
WEBSUB_SECRET=websub_secret_key_sumora
WEBSUB_CALLBACK_URL=http://localhost:5000/api/webhooks/youtube

# Push Notifications (Firebase & APNs)
FIREBASE_SERVICE_ACCOUNT_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
