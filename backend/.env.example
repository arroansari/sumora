PORT=5001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sumora_dev?schema=public"

# Cache & Queues (Redis - AWS ElastiCache / Upstash / Self-Hosted)
# Use REDIS_URL or standard REDIS_HOST/PORT/PASSWORD
# For Upstash or AWS ElastiCache with TLS in-transit encryption, use rediss:// or REDIS_TLS=true
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_REJECT_UNAUTHORIZED=false

# Worker Execution Architecture
# Set to 'false' in production to run BullMQ workers out-of-process via `npm run worker`
RUN_WORKERS_IN_PROCESS=true

# CORS Security (comma-separated allowed origins, or * in dev)
CORS_ALLOWED_ORIGINS=*

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Token Encryption at Rest (32-byte hex string for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth & YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/youtube/callback

# WebSub Webhook
WEBSUB_SECRET=websub_secret_key_sumora
WEBSUB_CALLBACK_URL=http://localhost:5000/api/webhooks/youtube

# Reddit OAuth & API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:5000/api/auth/reddit/callback
REDDIT_USER_AGENT=Sumora/1.0.0 (by /u/sumora_app)

# Push Notifications (Firebase Cloud Messaging & APNs)
# Provide either file path, raw JSON string, or base64 encoded JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
